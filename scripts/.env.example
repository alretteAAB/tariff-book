# Postgres connection strings per shard (Supabase -> Connect -> Session pooler
# or Direct connection, role postgres). Copy to scripts/.env; never commit it.
DATABASE_URL_1=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL_2=postgresql://postgres.yyyy:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
