# Cloudflare Pages Functions read these from the environment (set them in the
# Cloudflare Pages dashboard under Settings → Environment Variables, and in
# .dev.vars for local `wrangler pages dev`). They are NOT VITE_-prefixed
# because they must stay server-side — never expose the keys to the browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
